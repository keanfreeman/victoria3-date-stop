flowcontainer = {
	direction = horizontal
	spacing = 6
	visible = "[GetScriptedGui('dsm_delete_1_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
	text_single = { text = "DSM_SLOT_ROW_1" parentanchor = vcenter minimumsize = { 350 0 } max_width = 350 elide = right }
	button_icon_cancel = {
		size = { 24 24 }
		parentanchor = vcenter
		tooltip = "DSM_DELETE_TOOLTIP"
		onclick = "[GetScriptedGui('dsm_delete_1_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
	}
}
